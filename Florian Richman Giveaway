<script>
    // Lightbox Function
function openLightbox(src) {
      const box = document.querySelector('.lightbox');
      box.querySelector('img').src = src;
      box.classList.add('show');
    }

    // Auto Language Switch
    const userLang = navigator.language || navigator.userLanguage;
    if (userLang.startsWith('de')) {
      document.querySelectorAll('h3:nth-of-type(1), h3:nth-of-type(2), p').forEach(e => e.style.display = 'none');
      document.querySelectorAll('h3:nth-of-type(3), h3:nth-of-type(4), p:nth-of-type(n+7)').forEach(e => e.style.display = 'block');
      document.querySelector('.lightbox').style.display = 'flex';
      document.getElementById('lightbox-img').src = src;
}
